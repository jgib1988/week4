# This .gitignore follows GitHub's standard Unity template (github/gitignore),
# with a few macOS and Visual Studio additions.

# Generated by Unity: do not commit
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Unity3D generated meta files are NOT ignored (Unity needs them)
# Asset meta data should only be ignored when the corresponding asset is also ignored

# Autogenerated Visual Studio / Rider / IDE files
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vs/
.vsconfig
.idea/
*.DotSettings.user

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
*.codekit
*.tmp.*

# Unity3D generated crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Environment and secrets (keep keys out of the repo)
.env
.env.*
*.keystore
*.jks
*.p12
*.pem
*.key
secrets.*
